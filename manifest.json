{
    "name": "GitHub Ideas Extension",
    "version": "0.1.0",
    "manifest_version": 3,
    "description": "Save and commit your ideas directly to GitHub repositories",
    "icons": {
        "16": "extension_icon16.png",
        "48": "extension_icon48.png",
        "128": "extension_icon128.png",
        "512": "extension_icon512.png"
    },
    "permissions": [
        "activeTab", 
        "scripting",
        "identity",
        "storage"
    ],
    "action": {
        "default_popup": "extension.html",
        "default_icon": {
            "16": "extension_icon16.png",
            "48": "extension_icon48.png",
            "128": "extension_icon128.png",
            "512": "extension_icon512.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["js/content.js"]
        }
    ],
    "host_permissions": [
        "https://github.com/*",
        "https://api.github.com/*",
        "http://localhost:5000/*",
        "https:///*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}